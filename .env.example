# Copy this file to .env and fill in real values. .env is git-ignored.
# Never paste real keys into this file, chat prompts, or commits.

# LLM used by the agents (Mayank picks the provider)
LLM_API_KEY=

# Database (SQLite for the demo)
DATABASE_URL=sqlite:///./rahat.db

# Salt for hashing sender phone numbers (any long random string)
SENDER_HASH_SALT=change-me
